{
  "name": "telecode-executor",
  "version": "1.5.0",
  "description": "External Script Executor",
  "author": "TeleCode",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder -w"
  },
  "build": {
    "appId": "com.telecode.executor",
    "productName": "TeleCode-Executor",
    "icon": "TeleCode-icon.ico",
    "win": {
      "target": "portable",
      "icon": "TeleCode-icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      "Theme/**",
      "Data/**"
    ]
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "adm-zip": "^0.5.10"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  }
}